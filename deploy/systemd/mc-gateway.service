[Unit]
Description=Minecraft edge gateway
Documentation=https://github.com/InvalidJoker/mc-gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/mc-gateway --config /etc/mc-gateway/config.yaml
# SIGHUP re-reads the config: routes, servers, MOTD and limits change without
# dropping a single session. Listener changes still need a restart.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s

User=mc-gateway
Group=mc-gateway
ConfigurationDirectory=mc-gateway

# CAP_NET_ADMIN is only needed for `forwarding: transparent` (TPROXY).
# Drop it from both lines if every backend uses proxy_protocol_v2 or none.
# CAP_NET_BIND_SERVICE is only needed for ports below 1024.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE

# A process that terminates no TLS, stores nothing and runs one protocol parser
# has no business touching anything else on the box.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# One file descriptor per client plus one per backend connection.
LimitNOFILE=131072

[Install]
WantedBy=multi-user.target
