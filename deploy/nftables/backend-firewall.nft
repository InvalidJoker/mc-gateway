#!/usr/sbin/nft -f
#
# Backend host firewall.
#
# The whole design assumes backends are unreachable from the internet: the
# gateway enforces limits, answers pings and rate-limits joins, and all of that
# is worth nothing if players can still connect to 10.10.1.10:25565 directly.
#
# Set GATEWAY_ADDRS to your gateway addresses before loading.

define GATEWAY_ADDRS = { 10.10.0.2, 10.10.0.3 }
define MC_PORT = 25565

table inet mcbackend {
    chain input {
        type filter hook input priority filter; policy drop;

        ct state established,related accept
        iif lo accept

        # Minecraft only from the gateways.
        ip saddr $GATEWAY_ADDRS tcp dport $MC_PORT accept

        # Administration from the management network only.
        ip saddr 10.10.0.0/24 tcp dport 22 accept

        icmp type echo-request limit rate 5/second accept
    }
}
