#!/usr/sbin/nft -f
#
# Gateway side of the TPROXY return path. Loaded by tproxy-setup.sh, which also
# adds the routing rule these marks depend on.

# Declared and flushed first, so loading this twice does not duplicate rules.
table inet mcgateway
flush table inet mcgateway

table inet mcgateway {
    chain divert {
        type filter hook prerouting priority mangle; policy accept;

        # `socket transparent 1` matches packets that belong to an open
        # transparent socket — exactly the backend replies addressed to a
        # player's IP. The mark sends them to the local lookup table, which
        # delivers them to this process instead of routing them away.
        meta l4proto tcp socket transparent 1 meta mark set 1 accept
    }
}
